{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": false,
    // "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "composite": true,
    "isolatedDeclarations": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM"],
    // `examples/` import the package by name, as a consumer would; the paths
    // point that name at `src` so the examples typecheck against the source.
    "paths": {
      "unsecure": ["./src/index.ts"],
      "unsecure/utils": ["./src/utils/index.ts"],
      "unsecure/*": ["./src/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
