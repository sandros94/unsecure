{
  "name": "unsecure",
  "version": "0.2.3",
  "description": "Low-level Security utilities",
  "keywords": [
    "2fa",
    "argon2",
    "argon2id",
    "base32",
    "base64",
    "constant-time",
    "crypto",
    "cryptography",
    "csprng",
    "hex",
    "hkdf",
    "hmac",
    "hotp",
    "otp",
    "password-hashing",
    "prototype-pollution",
    "runtime-agnostic",
    "sanitize",
    "secure-random",
    "security",
    "sha256",
    "timing-safe",
    "totp",
    "typescript",
    "uuid",
    "uuidv7",
    "web-crypto",
    "webcrypto",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": {
    "name": "Sandro Circi",
    "email": "sandro.circi@digitoolmedia.com"
  },
  "repository": "sandros94/unsecure",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./argon2": {
      "types": "./dist/argon2.d.mts",
      "default": "./dist/argon2.mjs"
    },
    "./compare": {
      "types": "./dist/compare.d.mts",
      "default": "./dist/compare.mjs"
    },
    "./entropy": {
      "types": "./dist/entropy.d.mts",
      "default": "./dist/entropy.mjs"
    },
    "./errors": {
      "types": "./dist/errors.d.mts",
      "default": "./dist/errors.mjs"
    },
    "./generate": {
      "types": "./dist/generate.d.mts",
      "default": "./dist/generate.mjs"
    },
    "./hash": {
      "types": "./dist/hash.d.mts",
      "default": "./dist/hash.mjs"
    },
    "./hkdf": {
      "types": "./dist/hkdf.d.mts",
      "default": "./dist/hkdf.mjs"
    },
    "./hmac": {
      "types": "./dist/hmac.d.mts",
      "default": "./dist/hmac.mjs"
    },
    "./otp": {
      "types": "./dist/otp.d.mts",
      "default": "./dist/otp.mjs"
    },
    "./random": {
      "types": "./dist/random.d.mts",
      "default": "./dist/random.mjs"
    },
    "./sanitize": {
      "types": "./dist/sanitize.d.mts",
      "default": "./dist/sanitize.mjs"
    },
    "./uuid": {
      "types": "./dist/uuid.d.mts",
      "default": "./dist/uuid.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "default": "./dist/utils/index.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "dev:prepare": "obuild --stub && pnpm simple-git-hooks",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "oxlint --fix . && oxfmt .",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@node-rs/argon2": "^2.2.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "obuild": "^0.4.39",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^0.25.0",
    "rolldown": "1.2.7",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "unsecure": "link:."
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm stub && pnpm lint && pnpm typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.13 || >=24",
      "onFail": "error"
    }
  }
}
